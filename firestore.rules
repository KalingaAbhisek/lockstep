rules_version = '2';
// Lockstep's browsers and extension never talk to Firestore directly: only the API server does, through
// the Admin SDK, which bypasses these rules. So deny every direct read and write.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
