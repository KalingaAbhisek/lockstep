# Copy this file to .env. Never commit .env or service-account files.
# Existing OS environment variables override this file. Values are literal, without interpolation.
# SERVER ONLY: credentials are never included in generated browser configuration.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_EXTENSION_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://your-extension-id
FIREBASE_PROJECT_ID=your-firebase-project-id
# Blank uses Application Default Credentials; otherwise point to an ignored JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8080
TRUSTED_PROXIES=
SESSION_CACHE_SECONDS=5
PUBLIC_PATH_PREFIX=/lockstep
REAUTH_MAX_AGE_SECONDS=300
REQUIRE_VAULT_REVISION=true
ARGON2ID_WRAPPING=true
REQUIRE_EDIT_BASE=true

# PUBLIC: embedded in webapp/extension output; these are identifiers, never client secrets.
# Google client IDs above are also public. No GOOGLE_CLIENT_SECRET is needed by this app.
LOCKSTEP_API_BASE_URL=http://localhost:8080
LOCKSTEP_WEB_BASE_URL=http://localhost:5173/lockstep
LOCKSTEP_USE_API_PROXY=false
# Container webapp only; use the same value as GOOGLE_WEB_CLIENT_ID to skip config discovery.
LOCKSTEP_GOOGLE_CLIENT_ID=
# Optional Firebase Hosting same-origin API rewrite.
LOCKSTEP_CLOUD_RUN_SERVICE=
LOCKSTEP_CLOUD_RUN_REGION=us-east1
