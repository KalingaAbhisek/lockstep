{
  "manifest_version": 3,
  "name": "Lockstep",
  "description": "Secure authenticator codes, always in step across your devices.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "alarms", "identity", "scripting", "storage"],
  "host_permissions": ["http://localhost:8080/*","https://lockstep.1309.sh/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Lockstep"
  }
}

